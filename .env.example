# Copy to ".env.local" for local development. Never commit real values.
# In production these are set in Netlify: Site configuration > Environment variables.

# ---- Browser (exposed to the client bundle — VITE_ prefix) ----
# Firebase Web SDK config. Not secret (access control is enforced by
# Firestore/Storage rules and server-side checks), but kept out of git so
# each environment points at the right project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" to point the browser SDK at the local Firebase emulators.
VITE_USE_EMULATORS=false

# ---- Server only (Netlify Functions — NEVER prefix with VITE_) ----
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences; wrap in quotes.
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=

# Set when running functions against the local emulators (netlify dev + firebase emulators).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
