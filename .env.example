# Copy to ".env.local" for local scripts and `netlify dev`. Never commit real values.
# On Netlify these are set as site environment variables.
# Every environment-specific value lives here — nothing about a project,
# region, URL or tenant is hard-coded in the application.

# ---- Server (Netlify Functions + scripts/) — NEVER prefix with VITE_ ----
# development | staging | production. Demo-data scripts refuse "production".
LUNA_ENV=development
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Single line with literal \n sequences; wrap in quotes.
FIREBASE_PRIVATE_KEY=""
# Optional until file uploads exist.
FIREBASE_STORAGE_BUCKET=
# Public base URL of this deployment (used for password-setup links).
SITE_URL=
# Custom workspace links (paid): Luna adds each claimed name as a domain
# alias of this Netlify site. A Netlify personal access token (server only;
# never VITE_). Unset = links wait as "pending" until Luna finishes them
# with scripts/custom-links.js. NETLIFY_SITE_ID defaults to Netlify's SITE_ID.
NETLIFY_API_TOKEN=
# NETLIFY_SITE_ID=

# Set when running functions/scripts against the local emulators instead of the cloud.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Browser (exposed in the client bundle — VITE_ prefix) ----
# Firebase Web config is public by design; security comes from rules and server checks.
VITE_LUNA_ENV=development
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The domain custom workspace links live under (e.g. lunadigitalsystem.com;
# read by the server too). Unset = the feature is off.
VITE_CUSTOM_LINK_DOMAIN=
VITE_USE_EMULATORS=false
