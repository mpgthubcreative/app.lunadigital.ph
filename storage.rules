rules_version = '2';

// Luna tenant-scoped Storage rules (Phases 3-4). Deployed to staging in
// Phase 8 (bucket in us-west1); verified against the emulator and live.
//
// Layout: tenants/{bid}/{area}/...  (area = products | payments | imports | exports)
//
// Access mirrors firestore.rules. It reads the caller's own Firestore
// membership document (cross-service rules), the server-written permission
// map, the business's subscription status and its entitlement snapshot
// (the area's module must be enabled). Each area belongs to a module in
// shared/modules.js (`storage`); tests/shared/rules-registry.test.js keeps
// this file in sync with it.
//
// Difference from firestore.rules: no plan-existence lookup. Cross-service
// reads are billed and limited per request, so this file stays at two
// Firestore documents (member + business). A snapshot for a deleted plan is
// still denied server-side.
//
// Nothing is public, nothing outside tenants/ is reachable, and there is no
// browser write: uploads will go through server-issued, tenant-checked
// paths when a feature needs them.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    function validBusinessId(bid) {
      return bid is string && bid.matches('^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$');
    }

    function memberPath(bid) {
      return /databases/(default)/documents/businesses/$(bid)/members/$(request.auth.uid);
    }

    function businessPath(bid) {
      return /databases/(default)/documents/businesses/$(bid);
    }

    function activeMember(bid) {
      return signedIn()
        && validBusinessId(bid)
        && firestore.exists(memberPath(bid))
        && firestore.get(memberPath(bid)).data.get('status', null) == 'active';
    }

    function member(bid) {
      return firestore.get(memberPath(bid)).data;
    }

    function subscriptionStatus(bid) {
      return firestore.exists(businessPath(bid))
        ? firestore.get(businessPath(bid)).data.get('subscription', {}).get('status', null)
        : null;
    }

    function exportOnlyPermission(key) {
      return key in ['dashboard.view', 'reports.view', 'reports.export', 'billing.view', 'settings.view'];
    }

    function tenantReadable(bid) {
      return activeMember(bid)
        && (subscriptionStatus(bid) in ['active', 'past_due', 'suspended']
            || (subscriptionStatus(bid) == 'cancelled' && member(bid).get('isAccountOwner', false) == true));
    }

    function can(bid, key) {
      return tenantReadable(bid)
        && member(bid).get('permissions', {}).get(key, false) == true
        && (subscriptionStatus(bid) != 'cancelled' || exportOnlyPermission(key));
    }

    // Same snapshot validation as firestore.rules (minus the plan lookup).
    function moduleIds() {
      return ['dashboard', 'orders', 'payments', 'inventory', 'customers', 'reports', 'expenses', 'imports', 'users', 'settings', 'suppliers', 'production', 'returns'];
    }

    function limitKeys() {
      return ['users', 'ordersPerMonth', 'storageBytes', 'importsPerMonth'];
    }

    function featureKeys() {
      return ['reportsLevel', 'inAppNotifications', 'pushNotifications', 'googleSheets', 'advancedPermissions', 'workflowCustomization', 'support'];
    }

    function validModules(m) {
      return m is map
        && m.keys().hasOnly(moduleIds())
        && m.keys().hasAll(moduleIds())
        && m.dashboard == true
        && m.users == true
        && m.settings == true
        // Built modules are booleans; unbuilt ones (shared/modules.js
        // available: false) must be false: a snapshot can never enable a
        // module that isn't built (Phase 8.5 cleanup).
        && m.orders is bool
        && m.payments is bool
        && m.inventory is bool
        && m.customers is bool
        && m.reports is bool
        && m.expenses is bool
        && m.imports == false
        && m.suppliers == false
        && m.production == false
        && m.returns == false;
    }

    function validLimit(limits, key) {
      return limits[key] is int && limits[key] >= 0;
    }

    function validLimits(l) {
      return l is map
        && l.keys().hasOnly(limitKeys())
        && l.keys().hasAll(limitKeys())
        && validLimit(l, 'users')
        && validLimit(l, 'ordersPerMonth')
        && validLimit(l, 'storageBytes')
        && validLimit(l, 'importsPerMonth');
    }

    function validFeatures(f) {
      return f is map
        && f.keys().hasOnly(featureKeys())
        && f.keys().hasAll(featureKeys())
        && f.reportsLevel in ['basic', 'advanced']
        && f.inAppNotifications is bool
        && f.pushNotifications is bool
        && f.googleSheets is bool
        && f.advancedPermissions is bool
        && f.workflowCustomization is bool
        && f.support in ['standard', 'priority'];
    }


    // ---------- Workspace templates (Phase 8.5) ----------
    // Copy of shared/workspaces.js: each template's accepted versions
    // (upgradingFrom + current, during a rollout window) and the
    // OPERATIONAL (built) modules it allows (core included). tests/shared/rules-registry.test.js
    // fails if these drift from the registry.
    function workspaceTemplateVersions() {
      return {'distributor': [4], 'household-payroll': [1], 'baby-expense': [1], 'bridal-expense': [1]};
    }

    function workspaceTemplateModules() {
      return {
        'distributor': ['dashboard', 'users', 'settings', 'orders', 'payments', 'inventory', 'customers', 'expenses', 'reports'],
        'household-payroll': ['dashboard', 'users', 'settings'],
        'baby-expense': ['dashboard', 'users', 'settings'],
        'bridal-expense': ['dashboard', 'users', 'settings']
      };
    }

    // The snapshot was computed for the business's own, registered
    // template at its current version. Unknown, malformed, mismatched or
    // stale -> false.
    function workspaceValid(business, ent) {
      let t = business.get('workspaceTemplateId', null);
      return t is string
        && t in workspaceTemplateVersions()
        && ent.get('workspaceTemplateId', null) == t
        && ent.get('workspaceTemplateVersion', 0) in workspaceTemplateVersions()[t];
    }

    // Is the module allowed by the snapshot's (already validated) workspace?
    function workspaceAllows(business, ent, moduleId) {
      return moduleId in workspaceTemplateModules()[ent.workspaceTemplateId];
    }

    function entitlementsValid(bid) {
      let business = firestore.get(businessPath(bid)).data;
      let ent = business.get('entitlements', null);
      let planId = business.get('subscription', {}).get('planId', null);
      return ent is map
        && ent.get('schemaVersion', 0) == 2 && workspaceValid(business, ent)
        && planId is string
        && planId.matches('^[a-z][a-z0-9-]{1,31}$')
        && ent.get('planId', null) == planId
        && validModules(ent.get('modules', null))
        && validLimits(ent.get('limits', null))
        && validFeatures(ent.get('features', null));
    }

    function canAccessModule(bid, moduleId, key) {
      let business = firestore.get(businessPath(bid)).data;
      return can(bid, key)
        && entitlementsValid(bid)
        && business.entitlements.modules.get(moduleId, false) == true
        && workspaceAllows(business, business.entitlements, moduleId);
    }

    match /tenants/{bid} {
      match /products/{path=**} { allow read: if canAccessModule(bid, 'inventory', 'inventory.view'); }
      match /payments/{path=**} { allow read: if canAccessModule(bid, 'payments', 'payments.view'); }
      match /imports/{path=**}  { allow read: if canAccessModule(bid, 'imports', 'imports.run'); }
      match /exports/{path=**}  { allow read: if canAccessModule(bid, 'reports', 'reports.export'); }
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
