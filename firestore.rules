rules_version = '2';

// Phase 1: deny everything. Tenant-scoped rules (businesses/{bid}/...,
// membership + permission checks) arrive in Phase 3 together with the
// automated tenant-isolation test suite. Until then no client can read or
// write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
