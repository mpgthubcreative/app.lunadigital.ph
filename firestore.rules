rules_version = '2';

// Luna tenant-isolation + commercial access rules (Phases 3-4).
//
// Model
// - Every tenant record lives under businesses/{bid}/...
// - Access is granted ONLY by the caller's own membership document,
//   businesses/{bid}/members/{request.auth.uid}, which must be active.
//   users/{uid}.businessIds, custom claims, role names, URLs, headers and
//   anything else the browser controls are never consulted.
// - What a member may read comes from the server-written permission map
//   on that document (permissions.{key} == true). roleTemplate is a label.
// - Module data ALSO needs the business's entitlement snapshot
//   (businesses/{bid}.entitlements) to be valid, computed for the
//   business's current plan, and to have modules.{moduleId} == true.
//   A permission never unlocks a module the business isn't entitled to.
//   See canAccessModule(). The collection -> module / permission mapping
//   mirrors shared/modules.js; tests/shared/rules-registry.test.js fails
//   if the two drift.
// - Subscription policy mirrors shared/subscription.js + effectivePermissions
//   in shared/tenancy.js: active / past_due / suspended read normally,
//   cancelled = account owner only with export-only permissions,
//   anything else (missing, unknown) = deny.
//
// Writes: there is NO `allow write` / create / update / delete anywhere in
// this file. Every write goes through Netlify Functions (Admin SDK), which
// enforce login, membership, permission, module, subscription and limits.
// In particular plans, overrides and entitlement snapshots can only be
// changed by Luna operators, never from the browser.
//
// Not matched here (and therefore denied): plans, users, platformAudit,
// collection-group queries, and the server-only tenant collections
// paymentRefs, counters, usage, auditLog, integrations,
// skuIndex (per-business SKU uniqueness keys), idempotencyKeys (order create-once
// guards), reportRollups (Phase 11 report breakdowns, read only by the
// server's GET /api/reports so money stays behind dashboard.financials).
// counters and usage hold order numbering and plan-limit counts.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity ----------

    function signedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    // Same format as shared/tenancy.js isValidBusinessId. Hygiene only:
    // a well-formed id still needs a membership.
    function validBusinessId(bid) {
      return bid is string && bid.matches('^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$');
    }

    // ---------- Membership ----------

    function memberPath(bid) {
      return /databases/$(database)/documents/businesses/$(bid)/members/$(request.auth.uid);
    }

    function businessPath(bid) {
      return /databases/$(database)/documents/businesses/$(bid);
    }

    function activeMember(bid) {
      return signedIn()
        && validBusinessId(bid)
        && exists(memberPath(bid))
        && get(memberPath(bid)).data.get('status', null) == 'active';
    }

    function member(bid) {
      return get(memberPath(bid)).data;
    }

    // Owner protection is the isAccountOwner flag, never the role name.
    function isAccountOwner(bid) {
      return member(bid).get('isAccountOwner', false) == true;
    }

    // ---------- Subscription ----------

    function subscriptionStatus(bid) {
      return exists(businessPath(bid))
        ? get(businessPath(bid)).data.get('subscription', {}).get('status', null)
        : null;
    }

    // Permissions a cancelled (export-only) account keeps. Must match
    // EXPORT_ONLY_PERMISSIONS in shared/tenancy.js.
    function exportOnlyPermission(key) {
      return key in ['dashboard.view', 'reports.view', 'reports.export', 'billing.view', 'settings.view'];
    }

    // Can this caller see this business at all?
    function tenantReadable(bid) {
      return activeMember(bid)
        && (subscriptionStatus(bid) in ['active', 'past_due', 'suspended']
            || (subscriptionStatus(bid) == 'cancelled' && isAccountOwner(bid)));
    }

    // Does this caller hold permission `key` here, after the subscription's
    // export-only narrowing?
    function can(bid, key) {
      return tenantReadable(bid)
        && member(bid).get('permissions', {}).get(key, false) == true
        && (subscriptionStatus(bid) != 'cancelled' || exportOnlyPermission(key));
    }

    // ---------- Entitlements ----------

    // Same checks as validateEntitlementsSnapshot (shared/entitlements.js),
    // so the rules and the server accept and reject exactly the same
    // snapshots. The key lists must match MODULE_IDS / CORE_MODULE_IDS
    // (shared/modules.js) and LIMIT_DEFINITIONS / FEATURE_DEFINITIONS
    // (shared/plans.seed.js); tests/shared/rules-registry.test.js checks.
    function moduleIds() {
      return ['dashboard', 'orders', 'payments', 'inventory', 'customers', 'reports', 'expenses', 'imports', 'household', 'attendance', 'payroll', 'advances', 'users', 'settings', 'suppliers', 'production', 'returns'];
    }

    // Keys every snapshot must carry. During a module's staged rollout
    // (shared/modules.js ROLLING_OUT_MODULE_IDS) its key may still be
    // missing from older snapshots, where it reads as off. No rollout is
    // open now: every key is required.
    function requiredModuleIds() {
      return ['dashboard', 'orders', 'payments', 'inventory', 'customers', 'reports', 'expenses', 'imports', 'household', 'attendance', 'payroll', 'advances', 'users', 'settings', 'suppliers', 'production', 'returns'];
    }

    function limitKeys() {
      return ['users', 'ordersPerMonth', 'storageBytes', 'importsPerMonth'];
    }

    function featureKeys() {
      return ['reportsLevel', 'inAppNotifications', 'pushNotifications', 'googleSheets', 'advancedPermissions', 'workflowCustomization', 'support'];
    }

    // Every module present as a boolean; core modules on.
    function validModules(m) {
      return m is map
        && m.keys().hasOnly(moduleIds())
        && m.keys().hasAll(requiredModuleIds())
        && m.dashboard == true
        && m.users == true
        && m.settings == true
        // Built modules are booleans; unbuilt ones (shared/modules.js
        // available: false) must be false: a snapshot can never enable a
        // module that isn't built (Phase 8.5 cleanup).
        && m.orders is bool
        && m.payments is bool
        && m.inventory is bool
        && m.customers is bool
        && m.reports is bool
        && m.expenses is bool
        && m.imports is bool
        && m.household is bool
        && m.attendance is bool
        && m.payroll is bool
        && m.advances is bool
        && m.suppliers == false
        && m.production == false
        && m.returns == false;
    }

    function validLimit(limits, key) {
      return limits[key] is int && limits[key] >= 0;
    }

    function validLimits(l) {
      return l is map
        && l.keys().hasOnly(limitKeys())
        && l.keys().hasAll(limitKeys())
        && validLimit(l, 'users')
        && validLimit(l, 'ordersPerMonth')
        && validLimit(l, 'storageBytes')
        && validLimit(l, 'importsPerMonth');
    }

    function validFeatures(f) {
      return f is map
        && f.keys().hasOnly(featureKeys())
        && f.keys().hasAll(featureKeys())
        && f.reportsLevel in ['basic', 'advanced']
        && f.inAppNotifications is bool
        && f.pushNotifications is bool
        && f.googleSheets is bool
        && f.advancedPermissions is bool
        && f.workflowCustomization is bool
        && f.support in ['standard', 'priority'];
    }


    // ---------- Workspace templates (Phase 8.5) ----------
    // Copy of shared/workspaces.js: each template's accepted versions
    // (upgradingFrom + current, during a rollout window) and the
    // OPERATIONAL (built) modules it allows (core included). tests/shared/rules-registry.test.js
    // fails if these drift from the registry.
    function workspaceTemplateVersions() {
      return {'distributor': [5], 'household-payroll': [2], 'baby-expense': [1], 'bridal-expense': [1]};
    }

    function workspaceTemplateModules() {
      return {
        'distributor': ['dashboard', 'users', 'settings', 'orders', 'payments', 'inventory', 'customers', 'expenses', 'reports', 'imports'],
        'household-payroll': ['dashboard', 'users', 'settings', 'household', 'attendance', 'payroll', 'advances'],
        'baby-expense': ['dashboard', 'users', 'settings'],
        'bridal-expense': ['dashboard', 'users', 'settings']
      };
    }

    // The snapshot was computed for the business's own, registered
    // template at its current version. Unknown, malformed, mismatched or
    // stale -> false.
    function workspaceValid(business, ent) {
      let t = business.get('workspaceTemplateId', null);
      return t is string
        && t in workspaceTemplateVersions()
        && ent.get('workspaceTemplateId', null) == t
        && ent.get('workspaceTemplateVersion', 0) in workspaceTemplateVersions()[t];
    }

    // Is the module allowed by the snapshot's (already validated) workspace?
    function workspaceAllows(ent, moduleId) {
      return moduleId in workspaceTemplateModules()[ent.workspaceTemplateId];
    }

    // The stored snapshot is well-formed, current (schemaVersion 2 with a
    // valid workspace; no legacy shape is accepted), was
    // computed for the business's current plan and workspace template, and
    // that plan exists. Anything else (missing, stale, unknown plan or
    // template, wrong types) denies. Only called after tenantReadable(), so
    // the business doc exists.
    function entitlementsValid(bid) {
      let business = get(businessPath(bid)).data;
      let ent = business.get('entitlements', null);
      let planId = business.get('subscription', {}).get('planId', null);
      return ent is map
        && ent.get('schemaVersion', 0) == 2 && workspaceValid(business, ent)
        && planId is string
        && planId.matches('^[a-z][a-z0-9-]{1,31}$')
        && ent.get('planId', null) == planId
        && exists(/databases/$(database)/documents/plans/$(planId))
        && validModules(ent.get('modules', null))
        && validLimits(ent.get('limits', null))
        && validFeatures(ent.get('features', null));
    }

    // Exact boolean true only, and allowed by the workspace template.
    function moduleEnabled(bid, moduleId) {
      let business = get(businessPath(bid)).data;
      return business.entitlements.modules.get(moduleId, false) == true
        && workspaceAllows(business.entitlements, moduleId);
    }

    // THE module gate: active membership (+ subscription) AND the exact
    // permission AND a valid snapshot with the module switched on.
    function canAccessModule(bid, moduleId, key) {
      return can(bid, key)
        && entitlementsValid(bid)
        && moduleEnabled(bid, moduleId);
    }

    // The caller's own inbox, with in-app notifications in their package.
    function ownInbox(bid, uid) {
      return signedIn()
        && uid == request.auth.uid
        && get(businessPath(bid)).data.get('entitlements', {}).get('features', {}).get('inAppNotifications', false) == true;
    }

    // ---------- Tenant data ----------

    match /businesses/{bid} {
      // Profile, subscription and entitlements snapshot. No list: nobody
      // can enumerate businesses.
      allow get: if tenantReadable(bid);

      match /members/{uid} {
        allow get: if (signedIn() && uid == request.auth.uid && tenantReadable(bid))
          || canAccessModule(bid, 'users', 'users.view');
        allow list: if canAccessModule(bid, 'users', 'users.view');

        // Phase 13 notifications: a member reads ONLY their own inbox and
        // unread counter, while notifications are on for the business
        // (core Dashboard module + the plan's inAppNotifications feature).
        // Written only by the server (events, mark read).
        match /inbox/{nid}      { allow read: if canAccessModule(bid, 'dashboard', 'notifications.view') && ownInbox(bid, uid); }
        match /inboxState/{doc} { allow read: if canAccessModule(bid, 'dashboard', 'notifications.view') && ownInbox(bid, uid); }
      }

      match /products/{id}              { allow read: if canAccessModule(bid, 'inventory', 'inventory.view'); }
      match /inventoryTransactions/{id} { allow read: if canAccessModule(bid, 'inventory', 'inventory.view'); }
      // Costs live apart from quantities (same reason as financialMetrics):
      // staff who see stock levels don't see average cost or value.
      match /productCosts/{id}              { allow read: if canAccessModule(bid, 'inventory', 'inventory.costs'); }
      match /inventoryTransactionCosts/{id} { allow read: if canAccessModule(bid, 'inventory', 'inventory.costs'); }
      match /customers/{id}             { allow read: if canAccessModule(bid, 'customers', 'customers.view'); }
      match /expenses/{id}              { allow read: if canAccessModule(bid, 'expenses', 'expenses.view'); }
      match /orders/{id}                { allow read: if canAccessModule(bid, 'orders', 'orders.view'); }
      // Per-order COGS / gross profit: profitability, so dashboard.financials,
      // and only while the business has the Orders module.
      match /orderCosts/{id}            { allow read: if canAccessModule(bid, 'dashboard', 'dashboard.financials') && moduleEnabled(bid, 'orders'); }
      match /payments/{id}              { allow read: if canAccessModule(bid, 'payments', 'payments.view'); }
      match /metrics/{day}              { allow read: if canAccessModule(bid, 'dashboard', 'dashboard.view'); }
      // Money figures live apart from operational counts so they can need
      // their own permission (rules can't hide fields inside a document).
      match /financialMetrics/{day}     { allow read: if canAccessModule(bid, 'dashboard', 'dashboard.financials'); }
      match /reports/{id}               { allow read: if canAccessModule(bid, 'reports', 'reports.view'); }
      match /settings/{section}         { allow read: if canAccessModule(bid, 'settings', 'settings.view'); }

      // Phase 14: Household / Kasambahay Payroll.
      match /householdStaff/{id}        { allow read: if canAccessModule(bid, 'household', 'household.view'); }
      match /attendance/{id}            { allow read: if canAccessModule(bid, 'attendance', 'attendance.view'); }
      match /payrolls/{id}              { allow read: if canAccessModule(bid, 'payroll', 'payroll.view'); }
      match /advances/{id}              { allow read: if canAccessModule(bid, 'advances', 'advances.view'); }

      match /imports/{id} {
        allow read: if canAccessModule(bid, 'imports', 'imports.run');
        match /rows/{n} { allow read: if canAccessModule(bid, 'imports', 'imports.run'); }
      }
    }

    // Explicit default. Rules are allow-only, so this documents intent; it
    // can't revoke anything granted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
