{
  "name": "luna-business-os",
  "private": true,
  "version": "0.1.0",
  "description": "Luna Business Operations Platform — multi-tenant operations app (Vite + Firebase + Netlify Functions)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-luna --only firestore,storage \"vitest run --config vitest.rules.config.js\"",
    "test:all": "npm test && npm run test:rules",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --project demo-luna",
    "netlify:dev": "netlify dev",
    "deploy:rules:staging": "npm run test:rules && firebase deploy --only firestore:rules,firestore:indexes --project staging",
    "seed:plans": "node --env-file=.env.local scripts/seed-plans.js",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.js",
    "create-business": "node --env-file=.env.local scripts/create-business.js",
    "add-member": "node --env-file=.env.local scripts/add-member.js",
    "set-member-status": "node --env-file=.env.local scripts/set-member-status.js",
    "set-plan": "node --env-file=.env.local scripts/set-plan.js",
    "set-overrides": "node --env-file=.env.local scripts/set-overrides.js",
    "recompute-entitlements": "node --env-file=.env.local scripts/recompute-entitlements.js",
    "show-entitlements": "node --env-file=.env.local scripts/show-entitlements.js",
    "smoke:staging": "node --env-file=.env.local scripts/smoke-session.js"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "jsdom": "^29.1.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
